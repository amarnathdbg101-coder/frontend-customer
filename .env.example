# ShopSilo Frontend Environment Template
# Copy this file to .env.local or .env for local development

# Backend API Base URL (Production: https://shopsiloapi.shopsilo.in | Local: http://localhost:8080)
VITE_API_BASE_URL=https://shopsiloapi.shopsilo.in

# Cloudflare R2 / Custom CDN for High-Speed Edge Image Delivery
VITE_IMAGE_CDN_URL=https://images.shopsilo.in

# Google OAuth Web Client ID
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Customer App Public URL
VITE_CUSTOMER_APP_URL=https://shopsilo.in

# Sentry DSN for Error Monitoring (Optional in development)
VITE_SENTRY_DSN=
