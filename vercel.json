{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "https://shop.shopsilo.in/merchant",
      "permanent": false
    },
    {
      "source": "/merchant",
      "destination": "https://shop.shopsilo.in/merchant",
      "permanent": false
    },
    {
      "source": "/merchant/:path*",
      "destination": "https://shop.shopsilo.in/merchant/:path*",
      "permanent": false
    },
    {
      "source": "/seller",
      "destination": "https://shop.shopsilo.in/merchant",
      "permanent": false
    },
    {
      "source": "/pos",
      "destination": "https://shop.shopsilo.in/pos",
      "permanent": false
    },
    {
      "source": "/inventory",
      "destination": "https://shop.shopsilo.in/inventory",
      "permanent": false
    },
    {
      "source": "/expenses",
      "destination": "https://shop.shopsilo.in/expenses",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
